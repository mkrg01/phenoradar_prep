"""Run real image smoke checks through Snakemake and Apptainer."""
from pathlib import Path
import sys

ROOT = Path(workflow.basedir).parents[1]
sys.path.insert(0, str(ROOT / "workflow/scripts"))
from versioning import resolve_container_image

ENVIRONMENTS = sorted((ROOT / "workflow/envs").glob("*.yaml"))
containerized: resolve_container_image(config.get("container_image", "auto"), ROOT, enabled=True)

rule all:
    input: [f"smoke/{path.stem}.done" for path in ENVIRONMENTS]

for index, environment in enumerate(ENVIRONMENTS):
    rule:
        name: f"check_{environment.stem}"
        input: str(ROOT / "tests/container_smoke.py")
        output: f"smoke/{environment.stem}.done"
        params: environment=environment.stem
        conda: str(environment)
        log: f"smoke/{environment.stem}.log"
        shell:
            "PYTHONDONTWRITEBYTECODE=1 python {input:q} --environment {params.environment:q} "
            "> {log:q} 2>&1 && touch {output:q}"
