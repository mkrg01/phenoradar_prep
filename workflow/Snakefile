"""Metadata, ODB/KO expression, optional OG alignments and BUSCO phylogeny."""
import csv
import json
import re
import sys
from pathlib import Path
from snakemake_interface_executor_plugins.settings import DeploymentMethod

configfile: "workflow/pipeline_defaults.yaml"

ROOT = str(Path(workflow.basedir).parent)
SCRIPTS = str(Path(workflow.basedir) / "scripts")
sys.path.insert(0, SCRIPTS)
from configuration import validate_keys, validate_analysis
from layout import input_layout
INPUTS, BUSCO_FULL, SPECIES_LIST, CALIBRATIONS = input_layout(config.get("input_root", "input"))
from versioning import resolve_container_image
USE_CONTAINER = DeploymentMethod.APPTAINER in workflow.deployment_settings.deployment_method
try:
    validate_keys(config)
    validate_analysis(config)
    CONTAINER_IMAGE = resolve_container_image(ROOT) if USE_CONTAINER else None
except ValueError as error:
    raise WorkflowError(str(error))

if USE_CONTAINER:
    # Snakemake 9's local executor otherwise probes Conda on the host, even for
    # containerized jobs. The Miniforge image supplies its own Conda installation.
    if workflow.deployment_settings.conda_base_path is None:
        workflow.deployment_settings.conda_base_path = Path("/opt/conda")

containerized: CONTAINER_IMAGE

ODB_VERSION = "v12"
EXISTING_ODB = config["odb"]["existing_results"]
INCREMENTAL_ODB = config["odb"].get("incremental", False)
ODB_CACHE = config["odb"].get("cache_dir", "resources/odb_cache")
PYTHON = "python"
TAXONOMY_DB = "resources/taxonomy/taxa.sqlite"
TIMETREE_CACHE = "resources/timetree_cache"

if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", str(config["run_name"])):
    raise WorkflowError("run_name must be a simple directory name")
if type(config["odb"]["node"]) is not int or config["odb"]["node"] < 1:
    raise WorkflowError("odb.node must be a positive integer")
if config["tpm"]["multimap"] not in {"error", "drop", "split"}:
    raise WorkflowError("tpm.multimap must be error, drop, or split")
for section in ["alignment", "kegg"]:
    if type(config[section]["enabled"]) is not bool:
        raise WorkflowError(f"{section}.enabled must be true or false")
if config["kegg"]["ambiguity"] not in {"duplicate", "drop", "error"}:
    raise WorkflowError("kegg.ambiguity must be duplicate, drop, or error")
PHY = dict(config["phylogeny"], busco_full_dir=BUSCO_FULL,
           translation_table=config["translation"]["table"], trait=config["trait"])
for key in ["max_markers", "min_protein_length", "min_taxa"]:
    if type(PHY[key]) is not int or PHY[key] <= 0:
        raise WorkflowError(f"phylogeny.{key} must be a positive integer")
if type(PHY["max_unknown_fraction"]) not in {int, float} or not 0 <= PHY["max_unknown_fraction"] <= 1:
    raise WorkflowError("phylogeny.max_unknown_fraction must be between 0 and 1")
if PHY["trimal_mode"] not in {"gappyout", "automated1"}:
    raise WorkflowError("phylogeny.trimal_mode must be gappyout or automated1")
if PHY["min_taxa"] < 4:
    raise WorkflowError("phylogeny requires min_taxa >= 4")
if not isinstance(PHY["outgroup"], str) or not PHY["outgroup"].strip():
    raise WorkflowError("phylogeny.outgroup must be auto or an exact inference species label; use auto instead of null")
if not isinstance(PHY["lineage"], str) or not PHY["lineage"].strip():
    raise WorkflowError("phylogeny.lineage must be a nonempty string")
if type(PHY["dating"]["enabled"]) is not bool:
    raise WorkflowError("phylogeny.dating.enabled must be true or false")
if PHY["dating"]["calibration_source"] not in {"file", "timetree"}:
    raise WorkflowError("phylogeny.dating.calibration_source must be file or timetree")
from date_phylogeny import validate_settings as validate_treepl_settings
try:
    PHY["dating"]["treepl"] = validate_treepl_settings(PHY["dating"].get("treepl", {}))
except ValueError as error:
    raise WorkflowError(str(error))

ASTRAL = str(Path(ROOT) / "resources/phylogeny_tools/bin/astral4_int128")
from layout import (
    ORTHOGROUP_MAPPING, ORTHOGROUP_EXPRESSION, ORTHOGROUP_ALIGNMENTS,
    PHYLOGENY_BRANCHES, REPRESENTATIVES as REPRESENTATIVES_REL,
    ROOTING as ROOTING_REL,
)
from make_manifests import chunk_plan
from taxonomy_check import validate_settings as validate_taxonomy_check_settings
from filter_species import validate_exclusions, discover as discover_filter_inputs
from phenoradar_inputs import discover as discover_phenoradar_inputs
try:
    TAXONOMY_CHECK = validate_taxonomy_check_settings(PHY["taxonomy_check"])
    EXCLUDE_SPECIES = validate_exclusions(config["exclude_species"])
except ValueError as error:
    raise WorkflowError(str(error))
OUT = f'results/{config["run_name"]}'
WORK = f'work/{config["run_name"]}'
LOG = f'logs/{config["run_name"]}'
PROTEINS = str(Path(f"{OUT}/proteins").resolve())
META = f"{OUT}/metadata"
MAPPING = f"{OUT}/{ORTHOGROUP_MAPPING}"
MANIFESTS = f"{MAPPING}/manifests"
CHUNKS = f"{MAPPING}/chunks"
ODB_PLAN = f"{MAPPING}/incremental_plan"
TPM = f"{OUT}/{ORTHOGROUP_EXPRESSION}"
ALIGNMENTS = f"{OUT}/{ORTHOGROUP_ALIGNMENTS}"
ALIGNMENT_INPUTS = f"{WORK}/{ORTHOGROUP_ALIGNMENTS}/inputs"
ALIGNMENT_FINAL = [f"{ALIGNMENTS}/provenance.json"]
REFERENCE = f'resources/orthodb/{ODB_VERSION}_{config["odb"]["node"]}'
KEGG = f"{OUT}/kegg"
KEGG_SPECIES = f"{KEGG}/species"
KEGG_RUNS = f"{KEGG}/runs"
KEGG_REFERENCE = "resources/kegg/snapshot_v1"
KEGG_FINAL = [f"{KEGG}/{name}" for name in [
    "gene_kos.tsv", "genes.tsv", "ko_tpm_sum.tsv", "ko_tpm_sum_wide.tsv",
    "ko_support.tsv", "mapping_qc.tsv", "ko_modules.tsv", "ko_pathways.tsv",
    "reference_qc.json",
]]
PHYLO_BRANCHES = PHYLOGENY_BRANCHES
PHENOTYPED = f"{OUT}/{PHYLO_BRANCHES['phenotyped']}"
REPRESENTATIVES = f"{OUT}/{REPRESENTATIVES_REL}"
TREE_BRANCHES = dict(PHYLO_BRANCHES, representatives=REPRESENTATIVES_REL)
ACTIVE_TREE_BRANCHES = [TREE_BRANCHES[name] for name in PHY["trees"]]
PHYLO_BRANCH_PATTERN = "|".join(re.escape(branch) for branch in ACTIVE_TREE_BRANCHES) or r"(?!)"
MOLECULAR_BRANCH_PATTERN = "|".join(re.escape(TREE_BRANCHES[name]) for name in PHY["trees"]
                                      if name != "representatives") or r"(?!)"
DATING_BRANCH_PATTERN = MOLECULAR_BRANCH_PATTERN if PHY["dating"]["enabled"] else r"(?!)"
TAXONOMY_BRANCH_PATTERN = MOLECULAR_BRANCH_PATTERN if PHY["taxonomy_check"]["enabled"] else r"(?!)"
PAIR_BRANCH_PATTERN = MOLECULAR_BRANCH_PATTERN if PHY["contrast_pairs"]["enabled"] else r"(?!)"
CONTRAST_BRANCH_PATTERN = ("|".join(re.escape(f"{branch}/contrast") for branch in ACTIVE_TREE_BRANCHES)
                          if PHY["contrast_pairs"]["enabled"] else "") or r"(?!)"
GUIDE_BRANCH_PATTERN = "|".join(re.escape(f"{branch}/rooting") for branch in PHYLO_BRANCHES.values())
# All inference runs use the same rules, environments and settings.
PHYLO_RUN = f"{OUT}/{{phylo_branch}}"
wildcard_constraints:
    phylo_branch=PHYLO_BRANCH_PATTERN
CONTRAST = f"{REPRESENTATIVES}/contrast"
ROOTING = f"{OUT}/{ROOTING_REL}"
CONTRAST_OUTPUTS = [
    "contrast_pairs.tsv", "species_metadata.tsv", "summary.json", "summary_tree.nwk",
    "summary_tree.pdf", "summary_tree.svg", "contrastive.nwk"]

def phylogeny_targets(names):
    # Selecting targets must not change any inference job's parameters.
    return [f"{OUT}/{TREE_BRANCHES[s]}/{name}" for s in PHY["trees"] for name in names]


def requested_phylogeny(target, outputs):
    # Snakemake supplies CLI targets after parsing the Snakefile. Validate at
    # aggregate-rule expansion so this also applies to dry-runs and API calls.
    validate_analysis(config, [target])
    report_phylogeny_plan()
    return outputs


def contrast_targets(wc):
    validate_analysis(config, ["contrast_pairs"])
    report_phylogeny_plan()
    if EXCLUDE_SPECIES:
        if "representatives" in PHY["trees"]:
            raise WorkflowError("filtered contrast pairs do not support representatives; clear exclude_species or select all/phenotyped trees")
        snapshot = discover_filter_inputs(OUT, INPUTS["species_trait"])
        for species_set in PHY["trees"]:
            branch = PHYLO_BRANCHES[species_set]
            section = snapshot["sections"][f"{branch}_contrast"]
            if section["status"] != "ready":
                raise WorkflowError(f"excluded-species contrast requires completed {branch} inputs: {section['missing']}")
        return [f"{OUT}/filtered"]
    return [f"{OUT}/{TREE_BRANCHES[name]}/contrast/{output}"
            for name in PHY["trees"]
            for output in [*CONTRAST_OUTPUTS, *([] if name == "representatives" else ["observed_tree.nwk"])]]


PHYLO_FINAL = phylogeny_targets(["species_tree.nwk", "species_tree.json", "species_coverage.tsv"])
TAXONOMY_CHECK_FINAL = phylogeny_targets(["taxonomy_check"])
PHYLO_DATED = phylogeny_targets(["dating/species_tree.dated.nwk", "dating/provenance.json"])

from snakemake.logging import logger
PHYLOGENY_PLAN_REPORTED = False


def report_phylogeny_plan():
    # Log during DAG expansion, after Snakemake has configured its log handlers.
    global PHYLOGENY_PLAN_REPORTED
    if not PHYLOGENY_PLAN_REPORTED:
        logger.info("Phylogeny plan: trait=%s; trees=%s; contrast_pairs=%s; dating=%s; taxonomy_check=%s",
                    config["trait"], ",".join(PHY["trees"]) or "none",
                    PHY["contrast_pairs"]["enabled"], PHY["dating"]["enabled"], TAXONOMY_CHECK["enabled"])
        PHYLOGENY_PLAN_REPORTED = True


def sample_rows(wildcards):
    path = checkpoints.select_metadata.get().output.samples
    with open(path) as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def species_row(wildcards):
    rows = [r for r in sample_rows(wildcards) if r["odb_species"] == wildcards.species]
    if not rows:
        raise WorkflowError(f"species not selected: {wildcards.species}")
    return rows[0]


def run_row(wildcards):
    rows = [r for r in sample_rows(wildcards) if r["run"] == wildcards.run]
    if len(rows) != 1:
        raise WorkflowError(f"run not uniquely selected: {wildcards.run}")
    return rows[0]


def odb_plan(wildcards):
    root = checkpoints.plan_incremental_odb.get().output[0]
    return json.loads((Path(root) / "plan.json").read_text())


def odb_manifests(wildcards):
    return checkpoints.plan_incremental_odb.get().output[0] if INCREMENTAL_ODB else MANIFESTS


def odb_source_files(wildcards, suffix):
    if not INCREMENTAL_ODB:
        if EXISTING_ODB:
            return [f"{EXISTING_ODB}/" + ("snapshot.json" if suffix == "provenance.json" else "annotations.tsv")] if suffix in {"og.annotations", "provenance.json"} else []
        return [f'{CHUNKS}/{r["chunk"]}/' + ("provenance.json" if suffix == "provenance.json" else f'{r["chunk"]}.{suffix}') for r in chunk_rows(wildcards)]
    paths = []
    for source in odb_plan(wildcards)["sources"]:
        if source["kind"] == "existing":
            if suffix in {"og.annotations", "provenance.json"}:
                paths.append(str(Path(source["root"]) / ("snapshot.json" if suffix == "provenance.json" else "annotations.tsv")))
        else:
            label = source["chunk"]
            paths.append(f"{CHUNKS}/{label}/" + ("provenance.json" if suffix == "provenance.json" else f"{label}.{suffix}"))
    return paths


def chunk_rows(wildcards):
    if INCREMENTAL_ODB:
        return odb_plan(wildcards)["chunks"]
    return chunk_plan(sample_rows(wildcards), PROTEINS, rules.make_manifests.params.chunk_size)


def chunk_row(wildcards):
    rows = [r for r in chunk_rows(wildcards) if r["chunk"] == wildcards.chunk]
    if len(rows) != 1:
        raise WorkflowError(f"chunk not selected: {wildcards.chunk}")
    return rows[0]


def chunk_outputs(wildcards, suffix):
    return [f'{CHUNKS}/{r["chunk"]}/{r["chunk"]}.{suffix}' for r in chunk_rows(wildcards)]


def run_outputs(wildcards, suffix):
    return [f'{TPM}/runs/{r["run"]}.{suffix}' for r in sample_rows(wildcards)]


def kegg_species_outputs(wildcards, name):
    return sorted({f'{KEGG_SPECIES}/{r["odb_species"]}/{name}' for r in sample_rows(wildcards)})


def kegg_run_outputs(wildcards, suffix):
    return [f'{KEGG_RUNS}/{r["run"]}.{suffix}' for r in sample_rows(wildcards)]


rule all:
    input:
        f"{OUT}/run.json",
        f"{META}/species_metadata.tsv",
        f"{TPM}/tpm.tsv",
        f"{TPM}/tpm_wide.tsv",
        f"{TPM}/tpm_sum.tsv",
        f"{TPM}/tpm_sum_wide.tsv",
        f"{TPM}/mapping_qc.tsv",
        lambda wc: alignment_targets(wc) if config["alignment"]["enabled"] else [],
        KEGG_FINAL if config["kegg"]["enabled"] else [],
        lambda wc: requested_phylogeny("all", PHYLO_FINAL),
        PHYLO_DATED if PHY["dating"]["enabled"] else [],
        TAXONOMY_CHECK_FINAL if TAXONOMY_CHECK["enabled"] else [],
        contrast_targets if PHY["contrast_pairs"]["enabled"] else []


rule references:
    input:
        f"{REFERENCE}/reference.json",
        f"{REFERENCE}/files.json"


rule kegg_references:
    input:
        f"{KEGG_REFERENCE}/reference.json",
        f"{KEGG_REFERENCE}/files.json",
        f"{KEGG_REFERENCE}/ko_modules.tsv",
        f"{KEGG_REFERENCE}/ko_pathways.tsv"


rule proteins:
    input:
        lambda wc: sorted({f'{PROTEINS}/{r["odb_species"]}_protein.fa' for r in sample_rows(wc)})


rule mapping:
    input:
        f"{MAPPING}/mappings.sqlite",
        f"{MAPPING}/gene_orthogroups.tsv",
        f"{MAPPING}/merge_qc.json"


rule kegg:
    input:
        f"{OUT}/run.json",
        f"{META}/species_metadata.tsv",
        KEGG_FINAL


rule alignments:
    input:
        f"{OUT}/run.json",
        lambda wc: alignment_targets(wc)


rule phylogeny:
    input:
        f"{OUT}/run.json",
        lambda wc: requested_phylogeny("phylogeny", PHYLO_FINAL)


rule phylogeny_prepare:
    input:
        lambda wc: requested_phylogeny("phylogeny_prepare", phylogeny_targets(
            ["plan/markers.tsv", "plan/species.tsv", "plan/marker_stats.tsv", "plan/provenance.json"]))


rule taxonomy_check:
    input: lambda wc: requested_phylogeny("taxonomy_check", TAXONOMY_CHECK_FINAL)


rule contrast_pairs:
    input: contrast_targets


rule phylogeny_calibrations:
    input:
        lambda wc: requested_phylogeny("phylogeny_calibrations", phylogeny_targets(
            ["timetree/calibrations.tsv", "timetree/candidates.tsv", "timetree/provenance.json"]))


rule timetree:
    input:
        f"{OUT}/run.json",
        lambda wc: requested_phylogeny("timetree", PHYLO_DATED)


include: "rules/metadata.smk"
if config.get("build_manifest"):
    include: "rules/build_inputs.smk"
else:
    include: "rules/odb.smk"
include: "rules/tpm.smk"
