"""Metadata, ODB/KO expression preparation, and optional BUSCO phylogeny."""
import csv
import json
import re
import sys
from pathlib import Path

configfile: "config/config.yaml"

if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", str(config["analysis"])):
    raise WorkflowError("analysis must be a simple directory name")
if config["odb"]["version"] != "v12":
    raise WorkflowError("only ODB v12 is supported by this workflow")
EXISTING_ODB = config["odb"].get("existing_results")
if EXISTING_ODB is not None and (not isinstance(EXISTING_ODB, str) or not EXISTING_ODB.strip()):
    raise WorkflowError("odb.existing_results must be null or a snapshot directory")
if config["odb"]["chunk_size"] < 1 or config["odb"]["threads"] < 1:
    raise WorkflowError("ODB chunk_size and threads must be positive")
if config["odb"]["batch_size"] < config["odb"]["threads"]:
    raise WorkflowError("ODB batch_size must be >= threads")
if "mem_mb" in config["odb"]:
    raise WorkflowError("Replace odb.mem_mb with odb.mem_gb in your configuration (128000 MB = 128 GB)")
if type(config["odb"]["mem_gb"]) is not int or config["odb"]["mem_gb"] <= 0:
    raise WorkflowError("odb.mem_gb must be a positive integer in GB (1 GB = 1000 MB)")
if config["tpm"]["multimap"] not in {"error", "drop", "split"}:
    raise WorkflowError("tpm.multimap must be error, drop, or split")
if type(config["kegg"]["enabled"]) is not bool:
    raise WorkflowError("kegg.enabled must be true or false")
for key in ["threads", "mem_gb"]:
    if type(config["kegg"][key]) is not int or config["kegg"][key] <= 0:
        raise WorkflowError(f"kegg.{key} must be a positive integer")
for key in ["reference_dir", "command"]:
    if not isinstance(config["kegg"][key], str) or not config["kegg"][key].strip():
        raise WorkflowError(f"kegg.{key} must be a nonempty string")
if config["kegg"]["ambiguity"] not in {"drop", "error"}:
    raise WorkflowError("kegg.ambiguity must be drop or error")
PHY = dict(config["phylogeny"], translation_table=config["translation"]["table"])
for key in ["enabled"]:
    if type(PHY[key]) is not bool:
        raise WorkflowError(f"phylogeny.{key} must be true or false")
for key in ["min_sites", "min_informative_sites", "min_markers_per_species"]:
    if key in PHY:
        raise WorkflowError(f"phylogeny.{key} was removed; remove it from your configuration. These counts are now diagnostics")
for key in ["max_markers", "min_protein_length",
            "min_taxa", "align_threads", "tree_threads", "astral_threads",
            "preparation_mem_gb", "alignment_mem_gb", "trimming_mem_gb", "tree_mem_gb", "astral_mem_gb", "seed"]:
    if type(PHY[key]) is not int or PHY[key] <= 0:
        raise WorkflowError(f"phylogeny.{key} must be a positive integer")
if "min_occupancy" in PHY:
    raise WorkflowError("phylogeny.min_occupancy was removed; remove it from your configuration. Coverage is used for ranking and diagnostics")
for key in ["max_unknown_fraction"]:
    if type(PHY[key]) not in {int, float} or not 0 <= PHY[key] <= 1:
        raise WorkflowError(f"phylogeny.{key} must be between 0 and 1")
if "max_gap_fraction" in PHY:
    raise WorkflowError("phylogeny.max_gap_fraction was removed; column selection now uses trimAl")
if PHY["trimal_mode"] not in {"gappyout", "automated1"}:
    raise WorkflowError("phylogeny.trimal_mode must be gappyout or automated1")
if PHY["min_taxa"] < 4:
    raise WorkflowError("phylogeny requires min_taxa >= 4")
if PHY["sequence_mode"] not in {"cds", "protein"} or (PHY["sequence_mode"] == "protein" and not PHY["sequence_dir"]):
    raise WorkflowError("phylogeny.sequence_mode must be cds or protein; protein mode requires sequence_dir")
for key in ["clade_rank", "clade_min_species", "min_clade_occupancy"]:
    if key in PHY:
        raise WorkflowError(f"phylogeny.{key} was removed; remove it from your configuration. Marker selection uses overall coverage")
for key in ["busco_full_dir", "sequence_dir", "outgroup"]:
    if PHY[key] is not None and (not isinstance(PHY[key], str) or not PHY[key].strip()):
        raise WorkflowError(f"phylogeny.{key} must be null or a nonempty string")
for key in ["busco_full_suffix", "sequence_suffix"]:
    if not isinstance(PHY[key], str) or not PHY[key] or "/" in PHY[key] or "\\" in PHY[key]:
        raise WorkflowError(f"phylogeny.{key} must be a nonempty filename suffix")
for key in ["lineage", "famsa_command", "trimal_command", "veryfasttree_command", "astral_command"]:
    if not isinstance(PHY[key], str) or not PHY[key].strip():
        raise WorkflowError(f"phylogeny.{key} must be a nonempty string")
if type(PHY["dating"]["enabled"]) is not bool:
    raise WorkflowError("phylogeny.dating.enabled must be true or false")
if type(PHY["dating"]["mem_gb"]) is not int or PHY["dating"]["mem_gb"] <= 0:
    raise WorkflowError("phylogeny.dating.mem_gb must be a positive integer")
for key in ["calibrations"]:
    value = PHY["dating"][key]
    if value is not None and (not isinstance(value, str) or not value.strip()):
        raise WorkflowError(f"phylogeny.dating.{key} must be null or a nonempty path")
if not isinstance(PHY["dating"]["command"], str) or not PHY["dating"]["command"].strip():
    raise WorkflowError("phylogeny.dating.command must be a nonempty executable path")
if type(PHY["dating"]["threads"]) is not int or PHY["dating"]["threads"] < 1:
    raise WorkflowError("phylogeny.dating.threads must be a positive integer")
if "rate_partitions" in PHY["dating"]:
    raise WorkflowError("phylogeny.dating.rate_partitions was removed; dating now uses treePL")
if PHY["dating"]["calibration_source"] not in {"file", "timetree"}:
    raise WorkflowError("phylogeny.dating.calibration_source must be file or timetree")
TT = PHY["dating"]["timetree"]
if "min_clade_taxa" in TT:
    raise WorkflowError("phylogeny.dating.timetree.min_clade_taxa was removed; remove it from your configuration. Query limits control workload")
for key in ["max_representatives", "max_queries", "min_studies"]:
    if type(TT[key]) is not int or TT[key] < 1:
        raise WorkflowError(f"phylogeny.dating.timetree.{key} must be a positive integer")
if TT["max_representatives"] < 2 or type(TT["offline"]) is not bool:
    raise WorkflowError("TimeTree requires max_representatives >= 2 and boolean offline")
for key in ["python", "cache_dir"]:
    if not isinstance(TT[key], str) or not TT[key].strip():
        raise WorkflowError(f"phylogeny.dating.timetree.{key} must be a nonempty string")
if TT["representatives"] is not None and (not isinstance(TT["representatives"], str) or not TT["representatives"].strip()):
    raise WorkflowError("TimeTree representatives must be null or a nonempty file path")
if type(TT["request_delay_seconds"]) not in {int, float} or not 0 <= TT["request_delay_seconds"] < float("inf"):
    raise WorkflowError("TimeTree request_delay_seconds must be finite and nonnegative")

ROOT = str(Path(workflow.basedir).parent)
SCRIPTS = str(Path(workflow.basedir) / "scripts")
sys.path.insert(0, SCRIPTS)
from make_manifests import chunk_plan
from date_phylogeny import validate_settings as validate_treepl_settings
validate_treepl_settings(PHY["dating"]["treepl"])
OUT = f'{config["paths"]["results"]}/{config["analysis"]}'
WORK = f'{config["paths"]["work"]}/{config["analysis"]}'
LOG = f'{config["paths"]["logs"]}/{config["analysis"]}'
PROTEINS = str(Path(f"{OUT}/proteins").resolve())
META = f"{OUT}/metadata"
MANIFESTS = f"{OUT}/odb/manifests"
CHUNKS = f"{OUT}/odb/chunks"
MERGED = f"{OUT}/odb/merged"
TPM = f"{OUT}/tpm"
REFERENCE = config["odb"]["reference_dir"]
PYTHON = config["tools"]["python"]
KEGG = f"{OUT}/kegg"
KEGG_SPECIES = f"{KEGG}/species"
KEGG_RUNS = f"{KEGG}/runs"
KEGG_REFERENCE = config["kegg"]["reference_dir"]
KEGG_FINAL = [f"{KEGG}/{name}" for name in [
    "gene_kos.tsv", "genes.tsv", "ko_tpm_sum.tsv", "ko_tpm_sum_wide.tsv",
    "ko_support.tsv", "mapping_qc.tsv", "ko_modules.tsv", "ko_pathways.tsv",
    "reference_qc.json",
]]
PHYLO = f"{OUT}/phylogeny"
PHYLO_PLAN = f"{PHYLO}/plan"
PHYLO_FINAL = [f"{PHYLO}/species_tree.nwk", f"{PHYLO}/species_tree.json", f"{PHYLO}/species_coverage.tsv"]
PHYLO_DATED = [f"{PHYLO}/dating/species_tree.dated.nwk", f"{PHYLO}/dating/provenance.json"]
if PHY["dating"]["enabled"]:
    PHYLO_FINAL += PHYLO_DATED

# Refuse output roots inside either user-provided input tree.
for destination in [OUT, WORK, LOG, REFERENCE, KEGG_REFERENCE]:
    dest = Path(destination).resolve()
    for source in [Path(config["inputs"]["metadata"]).resolve().parent,
                   Path(config["inputs"]["cds_dir"]).resolve().parent]:
        if dest == source or source in dest.parents:
            raise WorkflowError(f"output path overlaps input directory: {dest}")

for destination in [OUT, WORK, LOG]:
    dest, ref = Path(destination).resolve(), Path(KEGG_REFERENCE).resolve()
    if dest == ref or ref in dest.parents or dest in ref.parents:
        raise WorkflowError("kegg.reference_dir must not overlap results, work, or log directories")
    for source in [PHY["busco_full_dir"], PHY["sequence_dir"]]:
        if source:
            src = Path(source).resolve()
            if dest == src or src in dest.parents or dest in src.parents:
                raise WorkflowError("phylogeny input directories must not overlap output roots")


def sample_rows(wildcards):
    path = checkpoints.select_metadata.get().output.samples
    with open(path) as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def species_row(wildcards):
    rows = [r for r in sample_rows(wildcards) if r["odb_species"] == wildcards.species]
    if not rows:
        raise WorkflowError(f"species not selected: {wildcards.species}")
    return rows[0]


def run_row(wildcards):
    rows = [r for r in sample_rows(wildcards) if r["run"] == wildcards.run]
    if len(rows) != 1:
        raise WorkflowError(f"run not uniquely selected: {wildcards.run}")
    return rows[0]


def chunk_rows(wildcards):
    return chunk_plan(sample_rows(wildcards), PROTEINS, config["odb"]["chunk_size"])


def chunk_row(wildcards):
    rows = [r for r in chunk_rows(wildcards) if r["chunk"] == wildcards.chunk]
    if len(rows) != 1:
        raise WorkflowError(f"chunk not selected: {wildcards.chunk}")
    return rows[0]


def chunk_outputs(wildcards, suffix):
    return [f'{CHUNKS}/{r["chunk"]}/{r["chunk"]}.{suffix}' for r in chunk_rows(wildcards)]


def run_outputs(wildcards, suffix):
    return [f'{TPM}/runs/{r["run"]}.{suffix}' for r in sample_rows(wildcards)]


def kegg_species_outputs(wildcards, name):
    return sorted({f'{KEGG_SPECIES}/{r["odb_species"]}/{name}' for r in sample_rows(wildcards)})


def kegg_run_outputs(wildcards, suffix):
    return [f'{KEGG_RUNS}/{r["run"]}.{suffix}' for r in sample_rows(wildcards)]


rule all:
    input:
        f"{OUT}/run.json",
        f"{TPM}/tpm.tsv",
        f"{TPM}/tpm_wide.tsv",
        f"{TPM}/tpm_sum.tsv",
        f"{TPM}/tpm_sum_wide.tsv",
        f"{TPM}/mapping_qc.tsv",
        KEGG_FINAL if config["kegg"]["enabled"] else [],
        PHYLO_FINAL if PHY["enabled"] else []


rule prepare:
    input:
        f"{OUT}/run.json",
        f"{META}/samples.tsv",
        f"{META}/selection.json",
        f"{META}/busco_completeness.svg",
        MANIFESTS


rule references:
    input:
        f"{REFERENCE}/reference.json",
        f"{REFERENCE}/files.json"


rule proteins:
    input:
        lambda wc: sorted({f'{PROTEINS}/{r["odb_species"]}_protein.fa' for r in sample_rows(wc)})


rule mapping:
    input:
        f"{MERGED}/mappings.sqlite",
        f"{MERGED}/gene_orthogroups.tsv",
        f"{MERGED}/merge_qc.json"


rule kegg:
    input:
        f"{OUT}/run.json",
        KEGG_FINAL


rule phylogeny:
    input:
        f"{OUT}/run.json",
        PHYLO_FINAL


rule phylogeny_prepare:
    input:
        f"{PHYLO_PLAN}/markers.tsv",
        f"{PHYLO_PLAN}/species.tsv",
        f"{PHYLO_PLAN}/marker_stats.tsv",
        f"{PHYLO_PLAN}/provenance.json"


rule phylogeny_calibrations:
    input:
        f"{PHYLO}/timetree/calibrations.tsv",
        f"{PHYLO}/timetree/candidates.tsv",
        f"{PHYLO}/timetree/provenance.json"


rule timetree:
    input:
        f"{OUT}/run.json",
        PHYLO_DATED


include: "rules/metadata.smk"
include: "rules/odb.smk"
include: "rules/tpm.smk"
include: "rules/kegg.smk"
include: "rules/phylogeny.smk"
